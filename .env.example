# Local development (PostgreSQL)
PGHOST=localhost
PGPORT=5433
PGDATABASE=KnowledgeHub
PGUSER=postgres
PGPASSWORD=your_local_postgres_password

# Flask
FLASK_ENV=development
FLASK_DEBUG=0
FLASK_SECRET_KEY=change-this-to-a-random-secret

# Storage: "local" saves to static/courseware, "supabase" uses Supabase Storage
STORAGE_MODE=local
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=courseware

# DeepSeek API (server-side only, never expose to the browser)
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# For Vercel + Supabase deployment, set DATABASE_URL instead of the PG* vars:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
